# Copia este archivo a `.env` para levantar en modo producción (Docker Compose)
#
# IMPORTANTES:
# - Define secretos reales
# - Define hosts reales
# - Usa HTTPS delante (reverse proxy/ingress)

# -------------------------
# Base de datos (Postgres)
# -------------------------
POSTGRES_DB=sib_bridge
POSTGRES_USER=sib_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://sib_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/sib_bridge

# -------------------------
# Django
# -------------------------
DJANGO_SETTINGS_MODULE=config.settings.produccion
DJANGO_SECRET_KEY=CHANGE_ME_STRONG_SECRET_KEY
# Lista separada por coma (sin espacios)
ALLOWED_HOSTS=api.midominio.com,backend

# En producción, normalmente debe ser true detrás de reverse proxy HTTPS
DJANGO_FORCE_SSL=true

# -------------------------
# Redis / Celery
# -------------------------
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false

# -------------------------
# SUDEBAN
# -------------------------
SUDEBAN_API_URL=https://transacciones-demo.sudeban.gob.ve/api/transmission
SUDEBAN_USERNAME=CHANGE_ME
SUDEBAN_PASSWORD=CHANGE_ME

# En prod debe ser público/HTTPS (tu dominio) apuntando al endpoint interno
SUDEBAN_WEBHOOK_URL=https://api.midominio.com/api/internal/v1/core/webhooks
SUDEBAN_ID_ENTIDAD_BANCARIA=0106
SUDEBAN_REQUIRE_HTTPS=true

# -------------------------
# Frontend (Next.js / NextAuth)
# -------------------------
NEXT_PUBLIC_API_URL=https://api.midominio.com
INTERNAL_API_URL=http://backend:8000

NEXTAUTH_URL=https://app.midominio.com
NEXTAUTH_SECRET=CHANGE_ME_STRONG_NEXTAUTH_SECRET
