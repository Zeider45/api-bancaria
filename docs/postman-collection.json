{
  "info": {
    "_postman_id": "b5d6cc6d-9f07-4d54-a3b7-2a8073ab8e65",
    "name": "api-bancaria",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección Postman para api-bancaria (endpoints internos /api/internal/v1)."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "apiV1", "value": "{{baseUrl}}/api/internal/v1" },
    { "key": "apiIntervencion", "value": "{{apiV1}}/intervencion" },
    { "key": "apiSubasta", "value": "{{apiV1}}/subasta" },
    { "key": "apiMesaCambio", "value": "{{apiV1}}/mesa-de-cambio" },
    { "key": "apiResultadosSubasta", "value": "{{apiV1}}/resultados-subasta" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Genera un sufijo único por ejecución",
          "if (!pm.environment.get('suffix')) {",
          "  pm.environment.set('suffix', Date.now().toString());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Core",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{apiV1}}/health/", "host": ["{{apiV1}}"], "path": ["health", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json.status).to.eql('healthy');",
                  "pm.expect(json).to.have.property('timestamp');"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (dev-admin fallback)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{apiV1}}/auth/login/", "host": ["{{apiV1}}"], "path": ["auth", "login", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 o 401', () => pm.expect([200,401]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.have.property('username');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Catálogos (intervencion-api01)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{apiV1}}/catalogs/intervencion-api01/", "host": ["{{apiV1}}"], "path": ["catalogs", "intervencion-api01", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "['entes_supervisados','mecanismos_cambiarios','monedas','actividades_economicas','instrumentos_captacion','destinos_fondos','medios_pago']",
                  "  .forEach(k => pm.expect(json).to.have.property(k));"
                ]
              }
            }
          ]
        },
        {
          "name": "Config (puede fallar por wiring)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{apiV1}}/config/", "host": ["{{apiV1}}"], "path": ["config", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 o 500 (ver nota docs)', () => pm.expect([200,500]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('environment');",
                  "  pm.expect(json).to.have.property('timezone');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Intervención (API-01)",
      "item": [
        {
          "name": "Create transacción",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo_ente_supervisado\": \"0001\",\n  \"tipo_intervencion\": \"1\",\n  \"fecha_intervencion\": \"2026-03-23T10:00:00\",\n  \"codigo_identificacion_intervencion\": \"INT-{{suffix}}\",\n  \"fecha_operacion_cliente\": \"2026-03-23T09:00:00\",\n  \"moneda\": 840,\n  \"identificacion_cliente\": \"J123456789\",\n  \"nombre_cliente\": \"Cliente Prueba\",\n  \"actividad_economica_cliente\": \"0001\",\n  \"monto_divisa\": \"100.0000\",\n  \"tipo_cambio_bs\": \"40.0000\",\n  \"destino_fondos\": 1,\n  \"medio_pago\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{apiIntervencion}}/transacciones/create", "host": ["{{apiIntervencion}}"], "path": ["transacciones", "create"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.expect(json).to.have.property('id');",
                  "pm.expect(json).to.have.property('status');",
                  "pm.environment.set('intervencion_id', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Batch transacciones",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transacciones\": [\n    {\n      \"codigo_ente_supervisado\": \"0001\",\n      \"tipo_intervencion\": \"1\",\n      \"fecha_intervencion\": \"2026-03-23T10:00:00\",\n      \"codigo_identificacion_intervencion\": \"INT-B1-{{suffix}}\",\n      \"fecha_operacion_cliente\": \"2026-03-23T09:00:00\",\n      \"moneda\": 840,\n      \"identificacion_cliente\": \"J123456789\",\n      \"nombre_cliente\": \"Cliente Batch 1\",\n      \"actividad_economica_cliente\": \"0001\",\n      \"monto_divisa\": \"10.0000\",\n      \"tipo_cambio_bs\": \"40.0000\",\n      \"destino_fondos\": 1,\n      \"medio_pago\": 2\n    },\n    {\n      \"codigo_ente_supervisado\": \"0001\",\n      \"tipo_intervencion\": \"1\",\n      \"fecha_intervencion\": \"2026-03-23T10:00:00\",\n      \"codigo_identificacion_intervencion\": \"INT-B2-{{suffix}}\",\n      \"fecha_operacion_cliente\": \"2026-03-23T09:00:00\",\n      \"moneda\": 840,\n      \"identificacion_cliente\": \"J987654321\",\n      \"nombre_cliente\": \"Cliente Batch 2\",\n      \"actividad_economica_cliente\": \"0001\",\n      \"monto_divisa\": \"20.0000\",\n      \"tipo_cambio_bs\": \"40.0000\",\n      \"destino_fondos\": 1,\n      \"medio_pago\": 2\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{apiIntervencion}}/transacciones/batch", "host": ["{{apiIntervencion}}"], "path": ["transacciones", "batch"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.expect(json).to.have.property('success');",
                  "pm.expect(json).to.have.property('errors');"
                ]
              }
            }
          ]
        },
        {
          "name": "List transacciones",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiIntervencion}}/transacciones/?limit=50",
              "host": ["{{apiIntervencion}}"],
              "path": ["transacciones", ""],
              "query": [{ "key": "limit", "value": "50" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json()).to.be.an('array');"
                ]
              }
            }
          ]
        },
        {
          "name": "List rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{apiIntervencion}}/transacciones/rejected/", "host": ["{{apiIntervencion}}"], "path": ["transacciones", "rejected", ""] }
          }
        },
