          "name": "Get transacción by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{apiIntervencion}}/transacciones/{{intervencion_id}}", "host": ["{{apiIntervencion}}"], "path": ["transacciones", "{{intervencion_id}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 o 404', () => pm.expect([200,404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Correct transacción (solo rejected)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_cliente\": \"Cliente Corregido\"\n}",
              "options": { "raw": { "language": "json" } }
