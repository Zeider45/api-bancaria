            "url": { "raw": "{{apiIntervencion}}/transacciones/{{intervencion_id}}/correct", "host": ["{{apiIntervencion}}"], "path": ["transacciones", "{{intervencion_id}}", "correct"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200/400/404', () => pm.expect([200,400,404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Send pending (SUDEBAN)",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{apiIntervencion}}/transacciones/send-pending", "host": ["{{apiIntervencion}}"], "path": ["transacciones", "send-pending"] }
          }
        }
      ]
